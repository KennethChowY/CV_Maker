<header class="cv-header">
  <h1 class="cv-name">{{ cv.name }}</h1>
  {% if cv.headline %}<p class="cv-headline">{{ cv.headline | mark }}</p>{% endif %}
  {% if cv.contact or cv.links %}
  <p class="cv-contact">
    {% for c in cv.contact %}<span>{{ c }}</span>{% endfor %}
    {% for l in cv.links %}<span><a href="{{ l.url if '://' in l.url or l.url.startswith('mailto:') else 'https://' ~ l.url }}">{{ l.url | replace('https://', '') | replace('http://', '') }}</a></span>{% endfor %}
  </p>
  {% endif %}
</header>
{% if cv.summary %}
<section class="cv-section" data-section="summary"{% if "summary" in hidden %} hidden{% endif %}>
  <h2>Summary</h2>
  <p class="cv-summary">{{ cv.summary | mark }}</p>
</section>
{% endif %}
{% for s in cv.sections %}
<section class="cv-section{% if not s.entries %} cv-list{% endif %}" data-section="{{ s.heading | lower | trim }}"{% if (s.heading | lower | trim) in hidden %} hidden{% endif %}>
  <h2>{{ s.heading }}</h2>
  {% for e in s.entries %}
  <div class="cv-entry{% if e.bullets | length > 4 %} long{% endif %}">
    <div class="cv-entry-head">
      <span class="cv-entry-title">{{ e.title | mark }}</span>
      {% if e.dates %}<span class="cv-entry-dates">{{ e.dates | mark }}</span>{% endif %}
    </div>
    {% if e.subtitle or e.location %}
    <div class="cv-entry-sub"><span class="cv-entry-org">{{ e.subtitle | mark }}</span>{% if e.location %}<span class="cv-entry-loc">{{ e.location | mark }}</span>{% endif %}</div>
    {% endif %}
    {% if e.description %}<p class="cv-entry-desc">{{ e.description | mark }}</p>{% endif %}
    {% if e.bullets %}
    <ul>
      {% for b in e.bullets %}<li>{{ b | mark }}</li>{% endfor %}
    </ul>
    {% endif %}
  </div>
  {% endfor %}
  {% if s.items %}
  <ul class="cv-items">
    {% for i in s.items %}
    {% set parts = i.split(':', 1) %}
    {% if parts | length == 2 and parts[0] | length <= 30 %}
    <li><strong>{{ parts[0] | mark }}:</strong>{{ parts[1] | mark }}</li>
    {% else %}
    <li>{{ i | mark }}</li>
    {% endif %}
    {% endfor %}
  </ul>
  {% endif %}
</section>
{% endfor %}
