<header class="cv-header letter-header">
  <h1 class="cv-name">{{ profile.name or "Your Name" }}</h1>
  {% if contact %}
  <p class="cv-contact">{% for c in contact %}<span>{{ c }}</span>{% endfor %}</p>
  {% endif %}
</header>
{% if kind == "phd" %}
<h2 class="letter-title">Statement of Purpose</h2>
{% if role or company %}<p class="letter-re">{{ [role, company] | select | join(", ") }}</p>{% endif %}
{% else %}
<p class="letter-date">{{ today }}</p>
{% if company %}<p class="letter-to">Hiring Team<br>{{ company }}</p>{% endif %}
{% if role %}<p class="letter-re"><strong>Re: {{ role }}</strong></p>{% endif %}
{% endif %}
{% if letter.greeting %}<p class="letter-greeting">{{ letter.greeting | mark }}</p>{% endif %}
{% for p in letter.paragraphs %}
<p>{{ p | mark }}</p>
{% endfor %}
{% if letter.closing %}<p class="letter-closing">{{ letter.closing | mark }}</p>
<p class="letter-sign">{{ profile.name }}</p>{% endif %}
